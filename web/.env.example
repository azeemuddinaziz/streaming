# Where the web server reaches the API.
API_URL=http://localhost:3000
# Where the browser reaches the API (forms call it directly, with the sign-in cookie).
NEXT_PUBLIC_API_URL=http://localhost:3000
# Where the browser reaches the upload server (tusd).
NEXT_PUBLIC_TUS_URL=http://localhost:8080/files/
# The public address of this web app. Used for absolute link-preview addresses
# (og:url, og:image); never taken from request headers.
# Inlined at build time: changing it needs a rebuild.
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3001
