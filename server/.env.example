PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# A separate database that tests are allowed to wipe. Never point this at real data.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE_test

# Secret used to sign sign-in tokens. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Where the web app is served from, allowed to call this API with cookies.
WEB_ORIGIN=http://localhost:3001
# Optional. Set to the parent domain (e.g. .example.com) in production so the
# sign-in cookie is shared between the web app and the API subdomain.
# COOKIE_DOMAIN=
