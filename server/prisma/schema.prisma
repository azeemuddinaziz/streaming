// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  // The account name as the person typed it. Shown as-is and used to name their Channel.
  name     String
  // Lowercased name, so account names are unique regardless of case.
  nameKey  String   @unique
  password String
  channel  Channel?
  uploads  Upload[]
  comments Comment[]
}

model Channel {
  id     String  @id @default(uuid())
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id])
  videos Video[]
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

// A piece of content on a Channel, created only from a completed Upload.
model Video {
  id         String      @id @default(uuid())
  channelId  String
  channel    Channel     @relation(fields: [channelId], references: [id])
  status     VideoStatus @default(PROCESSING)
  visibility Visibility  @default(PRIVATE)
  // Set by the owner. Until then the Upload's filename is only a placeholder label.
  title       String?
  description String?
  // Set by the owner. While false, new Comments and edits are refused and only
  // the owner sees the existing ones; nothing is lost (GLOSSARY, Comments off).
  commentsEnabled Boolean   @default(true)
  createdAt  DateTime    @default(now())
  // Set when the owner deletes the Video. Nothing is removed; every read path
  // must leave out a Video that has it (see ADR 0001).
  deletedAt  DateTime?
  // The Upload this Video was made from, kept as a record of it.
  upload     Upload?
  // Storage keys of what processing produced; null until the Video is ready.
  masterPlaylistKey String?
  thumbnailKey      String?
  renditions        Rendition[]
  views             View[]
  comments          Comment[]

  @@index([channelId])
}

// One resolution of a Video, cut into HLS segments listed by its own playlist.
model Rendition {
  id          String @id @default(uuid())
  videoId     String
  video       Video  @relation(fields: [videoId], references: [id])
  width       Int
  height      Int
  // Peak bits per second the master playlist advertises for this Rendition.
  bandwidth   Int
  playlistKey String

  @@unique([videoId, height])
}

// One resumable transfer of a video file, owned by the User who started it.
model Upload {
  id          String    @id @default(uuid())
  // The id tusd gives the upload. With the S3 store it carries the object key
  // followed by a "+" and the multipart upload id, so take the key from before the "+".
  tusId       String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  filename    String
  size        BigInt
  createdAt   DateTime  @default(now())
  // Set once every byte has arrived. An Upload without it is unfinished.
  completedAt DateTime?
  // Set when the Upload was left unfinished for 24 hours and its bytes were removed.
  abandonedAt DateTime?
  // The Video made from this Upload, once it is completed.
  videoId     String?   @unique
  video       Video?    @relation(fields: [videoId], references: [id])

  @@index([userId])
}

// One counted watch of a Video. The unique key is what keeps a Viewer to one
// View per Video per day: `viewerKey` is "user:<id>" or "anon:<hash>", never a raw IP address.
model View {
  id        String   @id @default(uuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  viewerKey String
  // The UTC calendar day, as YYYY-MM-DD.
  day       String
  createdAt DateTime @default(now())

  @@unique([videoId, viewerKey, day])
}

// Plain text a signed-in User wrote on a Video. A Reply has a `parentId`;
// conversations are one level deep, so a parent is always a top-level Comment.
// `deletedAt` and `hiddenAt` are flags, nothing is removed (ADR 0001). Hiding a
// Comment hides its Replies by derivation, so a Reply's own `hiddenAt` is only
// for Replies hidden on their own. Reads go through the per-viewer filters in
// CommentRepository; `editedAt` is set when the author changes the text.
model Comment {
  id        String    @id @default(uuid())
  videoId   String
  video     Video     @relation(fields: [videoId], references: [id])
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  parentId  String?
  parent    Comment?  @relation("Replies", fields: [parentId], references: [id])
  replies   Comment[] @relation("Replies")
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  hiddenAt  DateTime?

  @@index([videoId, parentId, createdAt])
  @@index([parentId, createdAt])
  // For the per-User rate limit, which counts an author's recent Comments.
  @@index([authorId, createdAt])
}
