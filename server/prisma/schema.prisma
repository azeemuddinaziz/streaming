// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  // The account name as the person typed it. Shown as-is and used to name their Channel.
  name     String
  // Lowercased name, so account names are unique regardless of case.
  nameKey  String   @unique
  password String
  channel  Channel?
  uploads  Upload[]
}

model Channel {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

// One resumable transfer of a video file, owned by the User who started it.
model Upload {
  id        String   @id @default(uuid())
  // The id tusd gives the upload; it is also the key of its bytes in S3.
  tusId     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  filename  String
  size      BigInt
  createdAt DateTime @default(now())

  @@index([userId])
}
